# Configuration secrète pour webappden
# Copier ce fichier vers .env et remplir avec vos propres valeurs

# Clé secrète Django (générer une nouvelle clé unique)
SECRET_KEY=votre-cle-secrete-django-ici

# Configuration de la base de données
DB_NAME=webappden
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Configuration LDAP (mettre LDAP_ENABLED=False pour désactiver LDAP et utiliser l'auth Django standard)
LDAP_ENABLED=False
LDAP_AUTH_URL=ldap://192.168.0.109:389
LDAP_AUTH_SEARCH_BASE=cn=Users,dc=example,dc=local
LDAP_AUTH_ACTIVE_DIRECTORY_DOMAIN=example
LDAP_AUTH_CONNECTION_USERNAME=Webapp
LDAP_AUTH_CONNECTION_PASSWORD=votre-mot-de-passe-ldap

# Mode debug (True pour développement, False pour production)
DEBUG=True

# Hosts autorisés (séparer par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================
# SECURITY SETTINGS (for production behind Cloudflare + NGINX Proxy Manager)
# ===========================

# CSRF Trusted Origins (required for Django 4.0+ when behind reverse proxy)
# Format: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://webappden.yourdomain.com

# SSL/HTTPS Settings (activate when behind SSL-terminating reverse proxy)
SECURE_SSL_REDIRECT=False  # Set to True in production with HTTPS
SECURE_HSTS_SECONDS=0  # Set to 31536000 (1 year) in production
SECURE_HSTS_INCLUDE_SUBDOMAINS=False  # Set to True in production
SECURE_HSTS_PRELOAD=False  # Set to True in production

# Secure Cookies (activate in production with HTTPS)
SESSION_COOKIE_SECURE=False  # Set to True in production
CSRF_COOKIE_SECURE=False  # Set to True in production

# Browser Security Headers
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY  # Or SAMEORIGIN if you need iframes
