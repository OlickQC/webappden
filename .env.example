# Configuration secrète pour webappden
# Copier ce fichier vers .env et remplir avec vos propres valeurs

# Clé secrète Django (générer une nouvelle clé unique)
SECRET_KEY=votre-cle-secrete-django-ici

# Configuration de la base de données
DB_NAME=webappden
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Configuration LDAP (mettre LDAP_ENABLED=False pour désactiver LDAP et utiliser l'auth Django standard)
LDAP_ENABLED=False
LDAP_AUTH_URL=ldap://192.168.0.109:389
LDAP_AUTH_SEARCH_BASE=cn=Users,dc=example,dc=local
LDAP_AUTH_ACTIVE_DIRECTORY_DOMAIN=example
LDAP_AUTH_CONNECTION_USERNAME=Webapp
LDAP_AUTH_CONNECTION_PASSWORD=votre-mot-de-passe-ldap

# Mode debug (True pour développement, False pour production)
DEBUG=True
