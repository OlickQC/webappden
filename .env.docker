# Configuration Docker pour webappden
# Copiez ce fichier vers .env dans le dossier de votre stack sur Unraid

# Django Configuration
SECRET_KEY=CHANGEZ-CETTE-CLE-SECRETE-PAR-UNE-NOUVELLE-CLE-UNIQUE
DEBUG=False
ALLOWED_HOSTS=*

# ===========================
# SECURITY SETTINGS (for production behind Cloudflare + NGINX Proxy Manager)
# ===========================

# CSRF Trusted Origins (required for Django 4.0+ when behind reverse proxy)
# IMPORTANT: Replace with your actual domain(s)
# Format: https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://webappden.yourdomain.com,https://192.168.1.40

# SSL/HTTPS Settings (activate when behind SSL-terminating reverse proxy)
SECURE_SSL_REDIRECT=True  # Redirect HTTP to HTTPS
SECURE_HSTS_SECONDS=31536000  # 1 year HSTS
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Secure Cookies (required for HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Browser Security Headers
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY  # Or SAMEORIGIN if you need iframes

# Base de données MariaDB
# Option 1: Utiliser la base de données Docker locale (recommandé pour débuter)
DB_NAME=django-webappden
DB_USER=django
DB_PASSWORD=CHANGEZ-CE-MOT-DE-PASSE
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=CHANGEZ-CE-MOT-DE-PASSE-ROOT

# Option 2: Utiliser votre serveur MariaDB existant sur 192.168.1.40
# Décommentez les lignes suivantes et commentez celles ci-dessus
# DB_NAME=django-webappden
# DB_USER=django
# DB_PASSWORD=VotreMdpMariaDB
# DB_HOST=192.168.1.40
# DB_PORT=3306

# Configuration LDAP (mettre LDAP_ENABLED=False pour désactiver LDAP et utiliser l'auth Django standard)
LDAP_ENABLED=False
LDAP_AUTH_URL=ldap://VOTRE-SERVEUR-LDAP:389
LDAP_AUTH_SEARCH_BASE=cn=Users,dc=example,dc=local
LDAP_AUTH_ACTIVE_DIRECTORY_DOMAIN=example
LDAP_AUTH_CONNECTION_USERNAME=VotreUserLDAP
LDAP_AUTH_CONNECTION_PASSWORD=VotreMdpLDAP
